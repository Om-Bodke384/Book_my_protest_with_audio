# Leave empty for local dev (Vite proxies /api to localhost:5000, see vite.config.ts).
# In production, set this to your deployed backend URL, e.g.
# https://bookmyprotest-api.onrender.com/api
VITE_API_URL=

# Same Google OAuth Client ID you put in the backend's GOOGLE_CLIENT_ID.
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
