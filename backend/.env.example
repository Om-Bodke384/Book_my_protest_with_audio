PORT=5000
NODE_ENV=development

# Postgres connection string. For local dev this can be a local Postgres
# instance; for deployment, use your Neon connection string (see README) —
# it looks like: postgres://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bookmyprotest

# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Cloudinary (image uploads for protester photos / protest banners)
# https://console.cloudinary.com/console -> Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Create an "OAuth client ID" of type "Web application" and add both your
# local (http://localhost:5173) and deployed frontend URLs under
# "Authorized JavaScript origins". Only the Client ID is needed on the
# backend (it's used to verify tokens) — the Client Secret is NOT needed
# for this Google Identity Services flow.
GOOGLE_CLIENT_ID=

# Comma-separated list of allowed frontend origins, e.g.
# http://localhost:5173,https://book-my-protest-123.vercel.app
CLIENT_URL=https://book-my-protest-123.vercel.app
